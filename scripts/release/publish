#!/usr/bin/env bash

# shellcheck source-path=SCRIPTDIR
# shellcheck source=common.sh
source "$(dirname -- "$0")/common.sh"
[[ $# -ge 1 ]] || die "Usage: $(basename "$0") <crate>..."
require_clean

# Make sure HEAD matches origin/main before pushing the release tags.
# GitHub Actions handles the crates.io upload through Trusted Publishing.
git fetch origin refs/heads/main:refs/remotes/origin/main
[[ "$(git rev-parse HEAD)" == "$(git rev-parse refs/remotes/origin/main)" ]] \
  || die 'HEAD must match origin/main. Merge and update the checkout first.'

# Every tag goes on this commit, the release commit that bumped the crates.
refs=()
for crate in "$@"; do
  validate_crate "$crate"
  version="$(current_version "$crate")"
  validate_version "$version"
  tag="$(tag_of "$crate" "$version")"

  if git show-ref --verify --quiet "refs/tags/$tag"; then
    # If the push failed last time, reuse the tag as long as it's annotated
    # and still points to this commit.
    [[ "$(git cat-file -t "refs/tags/$tag")" == tag ]] \
      || die "tag $tag must be annotated"
    [[ "$(git rev-parse "refs/tags/$tag^{commit}")" == "$(git rev-parse HEAD)" ]] \
      || die "tag $tag points to a different commit"
  else
    git tag -s "$tag" -m "$tag"
  fi
  refs+=("refs/tags/$tag")
done

# One atomic push, so that every workflow run it starts sees every tag.
# Only the run of the first tag publishes, and a tag that landed after
# that run looked would never be published.
git push --atomic origin "${refs[@]}"
printf 'Pushed %s. Follow the publish workflow on GitHub Actions.\n' \
  "${refs[*]#refs/tags/}"
